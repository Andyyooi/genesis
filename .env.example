# Shared site password. Required in production (including Vercel).
# Unset only for local development: displays "password protection off (dev)".
SITE_PASSWORD=
# Recommended: an independent, long random secret for signing 30-day sessions.
# If unset, the signing key is derived from SITE_PASSWORD alone.
# Changing either value invalidates existing sessions.
SESSION_SECRET=
# Optional server-only token for the read-only JSON research export.
EXPORT_API_TOKEN=
# Server-only fine-grained GitHub PAT: Andyyooi/genesis, Actions read and write.
# Configure in Vercel Production only; never use a NEXT_PUBLIC_ prefix.
GITHUB_REFRESH_TOKEN=
# Optional overrides (defaults shown).
GITHUB_REPO=Andyyooi/genesis
GITHUB_REFRESH_REF=main
